---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import RemoteImage from '~/components/RemoteImage.astro';
import { cronologia } from '~/data/curated/cronologia';
import { arbolZoldyck } from '~/data/curated/genealogia';
import { arcosBySlug } from '~/data/curated/arcos';
import { charactersBySlug } from '~/lib/data';
import { url } from '~/lib/paths';

const historia = cronologia.filter((event) => event.kind === 'historia');
const publicacion = cronologia.filter((event) => event.kind === 'publicacion');

const generaciones = arbolZoldyck.generaciones.map((generacion) => ({
  titulo: generacion.titulo,
  miembros: generacion.miembros
    .map((miembro) => ({ ...miembro, character: charactersBySlug.get(miembro.slug) }))
    .filter((miembro) => miembro.character),
}));
---

<Base
  title="Cronología"
  description="Cronología interna de Hunter x Hunter año a año, cronología de publicación del manga y sus adaptaciones, y el árbol genealógico de la familia Zoldyck."
>
  <PageHeader
    eyebrow="Línea temporal"
    title="Cronología"
    lead="Qué ocurre y en qué orden, tanto dentro de la historia como fuera de ella. El calendario interno de la obra sitúa el examen de Cazador de Gon en el año 287."
    crumbs={[{ label: 'Cronología' }]}
  />

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Dentro de la obra</p>
        <h2>Qué pasa, año a año</h2>
        <p>Los eventos enlazan al arco donde se cuentan.</p>
      </div>
    </div>

    <ol class="timeline">
      {
        historia.map((event) => {
          const arc = event.arcSlug ? arcosBySlug.get(event.arcSlug) : null;
          return (
            <li class="event" style={arc ? `--dot: ${arc.color}` : '--dot: var(--accent)'}>
              <div class="when">{event.when}</div>
              <div class="body">
                <h3>{event.title}</h3>
                <p class="muted">{event.detail}</p>
                {arc && (
                  <a class="badge" href={url(`arcos/${arc.slug}`)}>
                    {arc.name}
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Fuera de la obra</p>
        <h2>Publicación y adaptaciones</h2>
        <p>Del primer capítulo en Shōnen Jump a las pausas del manga.</p>
      </div>
      <a class="button" href={url('series')}>Ver las obras</a>
    </div>

    <ol class="timeline timeline--pub">
      {
        publicacion.map((event) => (
          <li class="event">
            <div class="when">{event.when}</div>
            <div class="body">
              <h3>{event.title}</h3>
              <p class="muted">{event.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Genealogía</p>
        <h2>La familia Zoldyck</h2>
        <p>Tres generaciones de asesinos profesionales, más el servicio de la casa.</p>
      </div>
      <a class="button" href={url('organizaciones#familia-zoldyck')}>Ficha de la familia</a>
    </div>

    <div class="tree">
      {
        generaciones.map((generacion) => (
          <div class="generation">
            <p class="gen-title">{generacion.titulo}</p>
            <div class="members">
              {generacion.miembros.map((miembro) => (
                <a class="card member" href={url(`personajes/${miembro.slug}`)}>
                  <span class="portrait">
                    <RemoteImage src={miembro.character!.image} alt={miembro.character!.name} ratio="square" />
                  </span>
                  <span class="info">
                    <strong>{miembro.character!.name}</strong>
                    <small class="faint">{miembro.rol}</small>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .section:first-of-type {
    padding-top: 0;
  }

  .timeline {
    list-style: none;
    padding: 0;
    position: relative;
    margin-left: 0.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--border);
  }

  .event {
    position: relative;
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 1.5rem;
    padding-left: 1.75rem;
  }

  .event + .event {
    margin-top: 1.75rem;
  }

  .event::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--dot, var(--accent));
    border: 3px solid var(--bg);
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    padding-top: 0.15rem;
    letter-spacing: -0.01em;
  }

  .body h3 {
    font-size: 1.02rem;
  }

  .body p {
    font-size: 0.9rem;
    margin-top: 0.35rem;
    max-width: 65ch;
  }

  .body .badge {
    margin-top: 0.7rem;
  }

  .body a.badge:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .tree {
    display: grid;
    gap: 1.75rem;
  }

  .gen-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .members {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 0.75rem;
  }

  .member {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem 0.6rem 0.6rem;
  }

  .portrait {
    display: block;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .portrait :global(.media) {
    border-radius: 50%;
  }

  .info {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }

  .info strong {
    font-size: 0.9rem;
  }

  .info small {
    font-size: 0.75rem;
  }

  @media (max-width: 700px) {
    .event {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
