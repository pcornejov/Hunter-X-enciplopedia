---
import Base from '~/layouts/Base.astro';
import { url } from '~/lib/paths';

const suggestions = [
  { href: url('personajes'), label: 'Personajes', detail: 'Fichas del reparto completo' },
  { href: url('arcos'), label: 'Arcos', detail: 'La historia en orden' },
  { href: url('nen'), label: 'Nen', detail: 'El sistema de poder explicado' },
  { href: url('episodios'), label: 'Episodios', detail: 'Guía de las dos adaptaciones' },
];
---

<Base
  title="Página no encontrada"
  description="La página que buscas no existe en esta enciclopedia de Hunter x Hunter. Aquí tienes las secciones principales."
  noindex
>
  <div class="notfound">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página se fue al Continente Oscuro</h1>
    <p class="lead muted">
      No hay nada en esa dirección. Puede que el enlace esté mal escrito o que la ficha ya no exista.
    </p>

    <ul class="suggestions">
      {
        suggestions.map((item) => (
          <li>
            <a class="card" href={item.href}>
              <strong>{item.label}</strong>
              <span class="faint">{item.detail}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="button button--primary" href={url()}>Volver al inicio</a>
  </div>
</Base>

<style>
  .notfound {
    padding-block: clamp(3rem, 10vw, 6rem);
    max-width: 60ch;
  }

  .lead {
    margin-top: 1rem;
    font-size: 1.05rem;
  }

  .suggestions {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-block: 2rem;
  }

  .suggestions a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
  }

  .suggestions strong {
    font-size: 0.95rem;
  }

  .suggestions span {
    font-size: 0.8rem;
  }
</style>
